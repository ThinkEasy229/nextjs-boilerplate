# Clerk Authentication (optional unless you enable Clerk)
# Leave blank until you have real Clerk dashboard keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here

# CORS Configuration for Framer Site
FRAMER_ORIGIN=https://your-framer-site.framer.app

# Optional sales handoff
NEXT_PUBLIC_SALES_EMAIL=sales@yourcompany.com
SALES_EMAIL=sales@yourcompany.com
NEXT_PUBLIC_SALES_PHONE=(800) 555-0100
NEXT_PUBLIC_SALES_URL=https://example.com/contact-sales
SALES_URL=https://example.com/contact-sales
NEXT_PUBLIC_PREMIUM_CHECKOUT_URL=https://example.com/checkout
